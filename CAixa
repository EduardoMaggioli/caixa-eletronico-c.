}

int depositar(FILE *arquivo, long numero, double valor) {
    Conta conta;

    if (!valorValido(valor) ||
        buscarConta(arquivo, numero, &conta) != 1 ||
        conta.situacao != CONTA_ATIVA ||
        conta.saldo + valor > LIMITE) {
        return 0;
    }

    conta.saldo = arredondar(conta.saldo + valor);

    return atualizarConta(arquivo, &conta);
}

int sacar(FILE *arquivo, long numero, double valor) {
    Conta conta;

    if (!valorValido(valor) ||
        buscarConta(arquivo, numero, &conta) != 1 ||
        conta.situacao != CONTA_ATIVA ||
        conta.saldo < valor) {
        return 0;
    }

    conta.saldo = arredondar(conta.saldo - valor);

    return atualizarConta(arquivo, &conta);
}

int transferir(FILE *arquivo, long origem, long destino, double valor) {
    Conta a, b;

    if (origem == destino ||
        !valorValido(valor) ||
        buscarConta(arquivo, origem, &a) != 1 ||
        buscarConta(arquivo, destino, &b) != 1 ||
        a.situacao != CONTA_ATIVA ||
        b.situacao != CONTA_ATIVA ||
        a.saldo < valor ||
        b.saldo + valor > LIMITE) {
        return 0;
    }

    return sacar(arquivo, origem, valor) &&
           depositar(arquivo, destino, valor);
}

int encerrarConta(FILE *arquivo, long numero) {
    Conta conta;

    if (buscarConta(arquivo, numero, &conta) != 1 ||
        conta.situacao != CONTA_ATIVA ||
        conta.saldo != 0.0) {
        return 0;
    }

    conta.situacao = CONTA_ENCERRADA;

    return atualizarConta(arquivo, &conta);
}

/* Todas as alteracoes sao feitas em uma copia temporaria. */
FILE *iniciarOperacao(void) {
    FILE *origem = fopen(ARQUIVO, "rb");
    FILE *temporario;
    Conta conta;
    size_t lidos;
    int ok = 1;

    if (!origem && errno != ENOENT) {
        return NULL;
    }

    temporario = fopen(TEMPORARIO, "w+b");

    if (!temporario) {
        if (origem) {
            fclose(origem);
        }
        return NULL;
    }

    if (origem) {
        while ((lidos = fread(&conta, 1, sizeof conta, origem))
                == sizeof conta) {
            if (fwrite(&conta, sizeof conta, 1, temporario) != 1) {
                ok = 0;
                break;
            }
        }

        if (lidos != 0 || ferror(origem)) {
            ok = 0;
        }

        if (fclose(origem) != 0) {
            ok = 0;
        }
    }

    if (!ok) {
        fclose(temporario);
        remove(TEMPORARIO);
        return NULL;
    }

    return temporario;
}

/* Substitui o arquivo original apenas se a operacao inteira funcionar. */
int finalizarOperacao(FILE *arquivo, int sucesso) {
    if (sucesso && fflush(arquivo) != 0) {
        sucesso = 0;
    }

    if (sucesso) {
#ifdef _WIN32
        if (_commit(_fileno(arquivo)) != 0) {
            sucesso = 0;
        }
#else
        if (fsync(fileno(arquivo)) != 0) {
            sucesso = 0;
        }
#endif
    }

    if (fclose(arquivo) != 0) {
        sucesso = 0;
    }

    if (sucesso) {
#ifdef _WIN32
        sucesso = MoveFileExA(
            TEMPORARIO,
            ARQUIVO,
            MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH
        ) != 0;
#else
        sucesso = rename(TEMPORARIO, ARQUIVO) == 0;
#endif
    }

    if (!sucesso &&
        remove(TEMPORARIO) != 0 &&
        errno != ENOENT) {
        puts("Aviso: nao foi possivel remover o arquivo temporario.");
    }

    return sucesso;
}

int lerTexto(const char *mensagem, char *texto, size_t tamanho) {
    int c;
    size_t i;

    printf("%s", mensagem);

    if (!fgets(texto, (int)tamanho, stdin)) {
        puts("\nEntrada encerrada.");
        exit(0);
    }

    if (!strchr(texto, '\n') && !feof(stdin)) {
        c = getchar();

        if (c != '\n' && c != EOF) {
            while ((c = getchar()) != '\n' && c != EOF) {
            }

            puts("Texto muito longo.");
            return 0;
        }
    }

    texto[strcspn(texto, "\r\n")] = '\0';

    for (i = 0; texto[i]; i++) {
        if (!isspace((unsigned char)texto[i])) {
            return 1;
        }
    }

    puts("Preencha o campo.");
    return 0;
}

long lerNumero(const char *mensagem) {
    char texto[80];
    char *fim;
    long numero;

    for (;;) {
        if (!lerTexto(mensagem, texto, sizeof texto)) {
            continue;
        }

        errno = 0;
        numero = strtol(texto, &fim, 10);

        while (isspace((unsigned char)*fim)) {
            fim++;
        }

        if (!errno &&
            fim != texto &&
            *fim == '\0' &&
            numero >= 0) {
            return numero;
        }

        puts("Digite um numero inteiro valido, sem sinal negativo.");
    }
}

double lerValor(void) {
    char texto[80];
    char *fim;
    double valor;
    size_t i;

    for (;;) {
        if (!lerTexto("Valor (ex.: 25,50): ", texto, sizeof texto)) {
            continue;
        }

        for (i = 0; texto[i]; i++) {
            if (texto[i] == ',') {
                texto[i] = '.';
            }
        }

        errno = 0;
        valor = strtod(texto, &fim);

        while (isspace((unsigned char)*fim)) {
            fim++;
        }

        if (!errno &&
            fim != texto &&
            *fim == '\0' &&
            valorValido(valor)) {
            return arredondar(valor);
        }

        puts("Use valor positivo, ate 1 bilhao, com no maximo 2 casas decimais.");
    }
}

void mostrarConta(const Conta *conta) {
    printf("\nConta: %ld\n", conta->numero);
    printf("Titular: %.99s\n", conta->titular);
    printf("CPF: %.14s\n", conta->cpf);
    printf("Saldo: R$ %.2f\n", conta->saldo);
    printf("Situacao: %s\n",
           conta->situacao == CONTA_ATIVA ? "ATIVA" : "ENCERRADA");
}

void cadastrarConta(void) {
    Conta nova = {0};
    Conta existente;
    FILE *arquivo;
    int ok;

    nova.numero = lerNumero("Numero da conta (maior que zero): ");

    if (nova.numero == 0) {
        puts("Numero invalido.");
        return;
    }

    while (!lerTexto("Titular: ", nova.titular, sizeof nova.titular)) {
    }

    while (!lerTexto("CPF: ", nova.cpf, sizeof nova.cpf)) {
    }

    nova.saldo = 0;
    nova.situacao = CONTA_ATIVA;

    arquivo = iniciarOperacao();

    if (!arquivo) {
        puts("Erro ao abrir ou copiar os dados.");
        return;
    }

    ok = buscarConta(arquivo, nova.numero, &existente) == 0;

    if (!ok) {
        puts("Numero ja cadastrado ou erro de leitura.");
    }

    if (ok) {
        ok = fseek(arquivo, 0, SEEK_END) == 0;
    }

    if (ok) {
        ok = fwrite(&nova, sizeof nova, 1, arquivo) == 1;
    }

    if (finalizarOperacao(arquivo, ok)) {
        puts("Conta cadastrada.");
    } else {
        puts("Cadastro nao realizado.");
    }
}

void consultarConta(void) {
    Conta conta;
    long numero = lerNumero("Numero da conta: ");
    FILE *arquivo = fopen(ARQUIVO, "rb");
    int resultado;

    if (!arquivo) {
        puts(errno == ENOENT
             ? "Nenhuma conta cadastrada."
             : "Erro ao abrir arquivo.");
        return;
    }

    resultado = buscarConta(arquivo, numero, &conta);

    if (resultado == 1) {
        mostrarConta(&conta);
    } else {
        puts(resultado == 0
             ? "Conta nao encontrada."
             : "Erro de leitura.");
    }

    if (fclose(arquivo) != 0) {
        puts("Erro ao fechar arquivo.");
    }
}

void listarContas(void) {
    FILE *arquivo = fopen(ARQUIVO, "rb");
    Conta conta;
    size_t lidos;
    int quantidade = 0;

    if (!arquivo) {
        puts(errno == ENOENT
             ? "Nenhuma conta cadastrada."
             : "Erro ao abrir arquivo.");
        return;
    }

    while ((lidos = fread(&conta, 1, sizeof conta, arquivo))
            == sizeof conta) {
        mostrarConta(&conta);
        quantidade++;
    }

    if (lidos != 0 || ferror(arquivo)) {
        puts("Erro: registro incompleto ou falha de leitura.");
    }

    printf("\nTotal: %d conta(s).\n", quantidade);

    if (fclose(arquivo) != 0) {
        puts("Erro ao fechar arquivo.");
    }
}

void movimentar(long opcao) {
    long numero = lerNumero("Numero da conta (origem): ");
    long destino = 0;
    double valor = 0;
    FILE *arquivo;
    int ok = 0;

    if (opcao == 5) {
        destino = lerNumero("Numero da conta de destino: ");
    }

    if (opcao != 7) {
        valor = lerValor();
    }

    arquivo = iniciarOperacao();

    if (!arquivo) {
        puts("Erro ao abrir ou copiar os dados.");
        return;
    }

    switch (opcao) {
        case 3:
            ok = depositar(arquivo, numero, valor);
            break;

        case 4:
            ok = sacar(arquivo, numero, valor);
            break;

        case 5:
            ok = transferir(arquivo, numero, destino, valor);
            break;

        case 7:
            ok = encerrarConta(arquivo, numero);
            break;
    }

    if (finalizarOperacao(arquivo, ok)) {
        puts("Operacao concluida.");
    } else {
        puts("Operacao nao realizada. Confira contas, situacao e saldo.");
        puts("Tambem pode haver falha de gravacao.");
        puts("Os dados originais foram preservados.");
    }
}

int main(void) {
    long opcao;

    do {
        puts("\n=== CAIXA ELETRONICO ===");
        puts("1 - Cadastrar conta");
        puts("2 - Consultar conta");
        puts("3 - Realizar deposito");
        puts("4 - Realizar saque");
        puts("5 - Realizar transferencia");
        puts("6 - Listar contas");
        puts("7 - Encerrar conta");
        puts("0 - Sair");

        opcao = lerNumero("Opcao: ");

        switch (opcao) {
            case 1:
                cadastrarConta();
                break;

            case 2:
                consultarConta();
                break;

            case 3:
            case 4:
            case 5:
            case 7:
                movimentar(opcao);
                break;

            case 6:
                listarContas();
                break;

            case 0:
                puts("Programa encerrado.");
                break;

            default:
                puts("Opcao invalida.");
        }
    } while (opcao != 0);

    return 0;
}
