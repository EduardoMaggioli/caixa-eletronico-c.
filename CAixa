#define ARQUIVO "contas.dat"
#define TEMPORARIO "contas.tmp"
#define LIMITE 1000000000.0

typedef enum {
    CONTA_ENCERRADA,
    CONTA_ATIVA
} SituacaoConta;

typedef struct {
    long numero;
    char titular[100];
    char cpf[15];
    double saldo;
    SituacaoConta situacao;
} Conta;

double arredondar(double valor) {
    return round(valor * 100.0) / 100.0;
}

int valorValido(double valor) {
    return isfinite(valor) &&
           valor > 0 &&
           valor <= LIMITE &&
           fabs(valor * 100.0 - round(valor * 100.0)) < 0.00001;
}

/* Retorna 1 se encontrou, 0 se nao existe e -1 em caso de erro. */
int buscarConta(FILE *arquivo, long numero, Conta *conta) {
    size_t lidos;

    if (fseek(arquivo, 0, SEEK_SET) != 0) {
        return -1;
    }

    while ((lidos = fread(conta, 1, sizeof *conta, arquivo))
            == sizeof *conta) {
        if (conta->numero == numero) {
            return 1;
        }
    }

    return ferror(arquivo) || lidos != 0 ? -1 : 0;
}

